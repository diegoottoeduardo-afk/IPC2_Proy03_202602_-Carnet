@page
@model DteFrontend.Pages.Peticiones.ReportePdfModel
@{
    ViewData["Title"] = "Reporte en PDF";
}

<style>
    @@media print {
        header, footer, .no-print {
            display: none !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>

<div class="row no-print mb-4">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0 text-primary fw-bold">📄 Reporte Consolidado en Formato PDF</h4>
                    <p class="text-muted small mb-0">Descarga directa del PDF oficial generado por el servicio de backend o imprime la vista del reporte.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="@(Model.BackendUrl)/api/Reportes/pdf" target="_blank" class="btn btn-danger fw-bold">
                        ⬇️ Descargar PDF (Backend)
                    </a>
                    <button onclick="window.print()" class="btn btn-secondary fw-bold">
                        🖨️ Imprimir / Guardar PDF
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border p-4 bg-white" id="imprimible">
    <div class="text-center border-bottom pb-3 mb-4">
        <h3 class="fw-bold text-dark mb-1">SUPERINTENDENCIA DE ADMINISTRACIÓN TRIBUTARIA - SAT</h3>
        <h5 class="text-muted mb-1">Reporte General de Peticiones y Documentos Tributarios Electrónicos (DTE)</h5>
        <small class="text-muted">Fecha de generación: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</small>
    </div>

    <div class="mb-4">
        <h5 class="fw-bold text-primary border-bottom pb-2">1. Resumen Ejecutivo del Sistema</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="p-3 border rounded bg-light">
                    <span class="text-muted d-block">Monto Total Facturado Acumulado:</span>
                    <h3 class="fw-bold text-success mb-0">Q @Model.MontoTotalFacturado.ToString("N2")</h3>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded bg-light">
                    <span class="text-muted d-block">Servicio Generador:</span>
                    <h5 class="fw-bold text-dark mb-0">API REST .NET Core - Endpoint <code>/api/Reportes/pdf</code></h5>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <h5 class="fw-bold text-primary border-bottom pb-2">2. Peticiones Contempladas en el Sistema</h5>
        <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><strong>Consultar Contribuyente:</strong> Filtro por facturas emitidas o recibidas en un rango de fechas.</span>
                <span class="badge bg-success">Activo</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><strong>Resumen de IVA por Fecha y NIT:</strong> Desglose del IVA emitido y recibido por cada NIT.</span>
                <span class="badge bg-success">Activo</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><strong>Resumen por Rango de Fechas:</strong> Totales autorizados agrupados por fecha (con o sin IVA).</span>
                <span class="badge bg-success">Activo</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><strong>Gráficas Estadísticas:</strong> Visualización gráfica comparativa y evolutiva con Chart.js.</span>
                <span class="badge bg-success">Activo</span>
            </li>
        </ul>
    </div>

    <div class="alert alert-info border-0 mb-0">
        <strong>Nota de Calificación:</strong> Este reporte cumple con el requerimiento de generar el informe en formato PDF. Puede descargarse en archivo binario <code>.pdf</code> desde el botón superior o exportarse directamente mediante el diálogo de impresión del navegador.
    </div>
</div>
