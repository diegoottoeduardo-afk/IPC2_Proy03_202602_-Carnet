@page
@model DteFrontend.Pages.Peticiones.ConsultarContribuyenteModel
@{
    ViewData["Title"] = "Consultar Contribuyente";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h4 class="mb-0 text-primary fw-bold"> Consultar Contribuyente</h4>
                <p class="text-muted small mb-0">Consulta las facturas autorizadas emitidas o recibidas por un NIT en un rango de fechas determinado.</p>
            </div>
            <div class="card-body p-4">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <label for="nit" class="form-label fw-bold">NIT del Contribuyente:</label>
                        <input type="text" class="form-control" id="nit" name="nit" value="@Model.Nit" placeholder="Ej. 737810K" required>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Tipo de Facturas:</label>
                        <select class="form-select" name="tipo">
                            <option value="emitidas" selected="@(Model.Tipo == "emitidas")">Facturas Emitidas</option>
                            <option value="recibidas" selected="@(Model.Tipo == "recibidas")">Facturas Recibidas</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label for="fechaInicio" class="form-label fw-bold">Fecha Inicio:</label>
                        <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" value="@Model.FechaInicio">
                    </div>

                    <div class="col-md-3">
                        <label for="fechaFin" class="form-label fw-bold">Fecha Fin:</label>
                        <input type="date" class="form-control" id="fechaFin" name="fechaFin" value="@Model.FechaFin">
                    </div>

                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Buscar Facturas</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong> @Model.MensajeError
    </div>
}

@if (Model.HayBusqueda)
{
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 bg-primary text-white p-3 text-center">
                <h6 class="mb-1 text-uppercase">Cantidad Total de Facturas Autorizadas</h6>
                <h2 class="fw-bold mb-0">@Model.CantidadTotalFacturas</h2>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 bg-success text-white p-3 text-center">
                <h6 class="mb-1 text-uppercase">Monto Total Facturado en el Rango</h6>
                <h2 class="fw-bold mb-0">Q @Model.TotalFacturadoRango.ToString("N2")</h2>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                Detalle por Fecha - NIT: <code>@Model.Nit</code> (@(Model.Tipo == "emitidas" ? "Emitidas" : "Recibidas"))
            </h5>
            <span class="badge bg-secondary">@Model.DetallePorFecha.Count día(s) con movimientos</span>
        </div>
        <div class="card-body p-4">
            @if (Model.DetallePorFecha.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    No se encontraron facturas autorizadas para este NIT en el rango de fechas seleccionado.
                </div>
            }
            else
            {
                @foreach (var grupo in Model.DetallePorFecha)
                {
                    <div class="mb-4 p-3 border rounded bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-primary mb-0">📅 Fecha: @grupo.Fecha</h6>
                            <div>
                                <span class="badge bg-info text-dark me-2">Facturas: @grupo.CantidadFacturas</span>
                                <span class="badge bg-success fs-6">Total del día: Q @grupo.MontoTotal.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="table-responsive bg-white rounded border">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Referencia</th>
                                        <th>NIT Emisor</th>
                                        <th>NIT Receptor</th>
                                        <th>Valor (Q)</th>
                                        <th>IVA (Q)</th>
                                        <th>Total (Q)</th>
                                        <th>No. Autorización</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in grupo.Facturas)
                                    {
                                        <tr>
                                            <td><code>@f.Referencia</code></td>
                                            <td>@f.NitEmisor</td>
                                            <td>@f.NitReceptor</td>
                                            <td>Q @f.Valor.ToString("F2")</td>
                                            <td>Q @f.Iva.ToString("F2")</td>
                                            <td><strong>Q @f.Total.ToString("F2")</strong></td>
                                            <td><span class="badge bg-light text-dark border font-monospace">@f.CodigoAprobacion</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}
