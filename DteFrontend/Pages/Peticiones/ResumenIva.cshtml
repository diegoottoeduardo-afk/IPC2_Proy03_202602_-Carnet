@page
@model DteFrontend.Pages.Peticiones.ResumenIvaModel
@{
    ViewData["Title"] = "Resumen de IVA por Fecha y NIT";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h4 class="mb-0 text-primary fw-bold">💰 Resumen de IVA por Fecha y NIT</h4>
                <p class="text-muted small mb-0">Visualiza los movimientos tributarios por NIT para una fecha específica, detallando el IVA emitido e IVA recibido.</p>
            </div>
            <div class="card-body p-4">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="fecha" class="form-label fw-bold">Seleccionar Fecha:</label>
                        <input type="date" class="form-control" id="fecha" name="fecha" value="@Model.Fecha" required>
                    </div>

                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Filtrar por Fecha</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong> @Model.MensajeError
    </div>
}

@if (Model.HayBusqueda)
{
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 bg-info text-dark p-3 text-center">
                <h6 class="mb-1 text-uppercase fw-semibold">Total IVA Emitido en Fecha @Model.FechaMostrada</h6>
                <h2 class="fw-bold mb-0">Q @Model.TotalIvaEmitido.ToString("N2")</h2>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 bg-warning text-dark p-3 text-center">
                <h6 class="mb-1 text-uppercase fw-semibold">Total IVA Recibido en Fecha @Model.FechaMostrada</h6>
                <h2 class="fw-bold mb-0">Q @Model.TotalIvaRecibido.ToString("N2")</h2>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                Movimientos de IVA por Contribuyente - @Model.FechaMostrada
            </h5>
            <span class="badge bg-secondary">@Model.Movimientos.Count contribuyente(s)</span>
        </div>
        <div class="card-body p-4">
            @if (Model.Movimientos.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    No se registraron movimientos de IVA en la fecha seleccionada.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle border">
                        <thead class="table-primary">
                            <tr>
                                <th>#</th>
                                <th>NIT</th>
                                <th>Nombre del Contribuyente</th>
                                <th class="text-end">IVA Emitido (Q)</th>
                                <th class="text-end">IVA Recibido (Q)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Movimientos.Count; i++)
                            {
                                var m = Model.Movimientos[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><code>@m.Nit</code></td>
                                    <td>@m.Nombre</td>
                                    <td class="text-end text-success fw-semibold">Q @m.IvaEmitido.ToString("N2")</td>
                                    <td class="text-end text-primary fw-semibold">Q @m.IvaRecibido.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="3" class="text-end">TOTALES:</td>
                                <td class="text-end text-success fs-6">Q @Model.TotalIvaEmitido.ToString("N2")</td>
                                <td class="text-end text-primary fs-6">Q @Model.TotalIvaRecibido.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
}
