<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SAT Facturación DTE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    SAT - Portal DTE
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Enviar Mensaje</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="peticionesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Peticiones
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="peticionesDropdown">
                                <li><a class="dropdown-item" asp-page="/Peticiones/ConsultarContribuyente">Consultar Contribuyente</a></li>
                                <li><a class="dropdown-item" asp-page="/Peticiones/ResumenIva">Resumen IVA por fecha y NIT</a></li>
                                <li><a class="dropdown-item" asp-page="/Peticiones/ResumenRango">Resumen por rango de fechas</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-page="/Peticiones/Graficas">Gráficas</a></li>
                                <li><a class="dropdown-item" asp-page="/Peticiones/ReportePdf">Reporte PDF</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="ayudaDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Ayuda
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="ayudaDropdown">
                                <li><a class="dropdown-item" asp-page="/Ayuda/Estudiante">Información del Estudiante</a></li>
                                <li><a class="dropdown-item" asp-page="/Ayuda/Documentacion">Documentación del Programa</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="btn btn-warning text-dark fw-bold btn-sm" asp-page="/Inicializar">
                                Inicializar Sistema
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top bg-white py-3 text-center text-muted fixed-bottom">
        <div class="container">
            <small>IPC 2 - Proyecto 3 &bull; Superintendencia de Administración Tributaria (SAT) - Simulador DTE</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
