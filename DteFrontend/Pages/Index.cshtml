@page
@model IndexModel
@{
    ViewData["Title"] = "Enviar Mensaje";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h4 class="mb-0 text-primary fw-bold"> Enviar Mensaje a la SAT</h4>
                <p class="text-muted small mb-0">Selecciona o carga un archivo JSON para actualizar el RTU o solicitar autorizaciones de facturas electrónicas (DTE).</p>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.MensajeExito))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong> Éxito:</strong> @Model.MensajeExito
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.MensajeError))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong> Ocurrió un error:</strong> @Model.MensajeError
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="post" enctype="multipart/form-data">
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Tipo de Mensaje:</label>
                        <div class="col-sm-9">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="TipoMensaje" value="RTU" id="tipoRtu" checked>
                                <label class="form-check-label fw-semibold" for="tipoRtu">
                                     Actualizar RTU (Contribuyentes)
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="TipoMensaje" value="DTE" id="tipoDte">
                                <label class="form-check-label fw-semibold" for="tipoDte">
                                     Autorización de Facturas (DTE)
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="archivoJson" class="form-label fw-bold">Seleccionar archivo JSON:</label>
                        <input class="form-control" type="file" asp-for="ArchivoJson" id="archivoJson" accept=".json">
                        <div class="form-text">Puedes subir un archivo con extensión <code>.json</code> con la estructura indicada en la especificación.</div>
                    </div>

                    <div class="mb-3">
                        <label for="contenidoJson" class="form-label fw-bold">O pegar / escribir JSON directamente:</label>
                        <textarea class="form-control font-monospace" asp-for="ContenidoManualJson" id="contenidoJson" rows="6" placeholder='[&#10;  { "NIT": "737810K", "nombre": "Empresa ABC, S.A." }&#10;]'></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-outline-secondary">Limpiar Formulario</button>
                        <button type="submit" class="btn btn-primary px-4 fw-bold"> Enviar Mensaje a la API</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.RespuestaJsonCruda))
{
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-success fw-bold">📋 Respuesta del Servidor (API)</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.RtuNuevos.HasValue)
                    {
                        <div class="row text-center mb-4 g-3">
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border border-success">
                                    <h6 class="text-muted mb-1">Contribuyentes Nuevos</h6>
                                    <h2 class="text-success fw-bold mb-0">@Model.RtuNuevos</h2>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border border-primary">
                                    <h6 class="text-muted mb-1">Contribuyentes Actualizados</h6>
                                    <h2 class="text-primary fw-bold mb-0">@Model.RtuActualizados</h2>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border border-danger">
                                    <h6 class="text-muted mb-1">NITs Inválidos</h6>
                                    <h2 class="text-danger fw-bold mb-0">@Model.RtuInvalidos</h2>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.FacturasAprobadas.HasValue)
                    {
                        <div class="row text-center mb-4 g-3">
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border border-success">
                                    <h6 class="text-muted mb-1">Autorizaciones Aprobadas</h6>
                                    <h2 class="text-success fw-bold mb-0">@Model.FacturasAprobadas</h2>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border border-warning">
                                    <h6 class="text-muted mb-1">Rechazadas (Emisor Inexistente)</h6>
                                    <h2 class="text-warning fw-bold mb-0">@Model.FacturasRechazadasEmisor</h2>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border border-danger">
                                    <h6 class="text-muted mb-1">Rechazadas (Receptor Inexistente)</h6>
                                    <h2 class="text-danger fw-bold mb-0">@Model.FacturasRechazadasReceptor</h2>
                                </div>
                            </div>
                        </div>

                        @if (Model.Aprobaciones != null && Model.Aprobaciones.Count > 0)
                        {
                            <h6 class="fw-bold mb-3">Detalle de Aprobaciones Emitidas:</h6>
                            <div class="table-responsive mb-4">
                                <table class="table table-bordered table-striped table-hover align-middle">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>#</th>
                                            <th>Referencia del Emisor</th>
                                            <th>Código de Aprobación SAT (yyyymmdd########)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.Aprobaciones.Count; i++)
                                        {
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td><code>@Model.Aprobaciones[i].Referencia</code></td>
                                                <td><span class="badge bg-success fs-6 font-monospace">@Model.Aprobaciones[i].CodigoAprobacion</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }

                    <div class="mt-3">
                        <label class="form-label fw-bold">Mensaje JSON de Salida:</label>
                        <pre class="bg-dark text-white p-3 rounded font-monospace" style="max-height: 350px; overflow-y: auto;"><code>@Model.RespuestaJsonCruda</code></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
